{
  "rules": {
    ".read": false,
    ".write": false,
    "wg": {
      "$code": {
        ".read":  "$code.length >= 6 && $code.length <= 64",
        ".write": "$code.length >= 6 && $code.length <= 64 && !data.child('_moved').exists() && (data.exists() || $code.matches(/^[A-ZÄÖÜ]{2,8}-[A-ZÄÖÜ]{2,8}-[A-HJKMNP-Z2-9]{6}$/))",

        "_moved": { ".validate": "newData.isBoolean() && newData.val() === true" },
        "_mt":    { ".validate": "newData.isNumber()" },
        "err": { "$id": { ".validate": "newData.hasChildren(['id'])", "$f": { ".validate": "newData.isString() ? newData.val().length <= 500 : (newData.isNumber() || newData.isBoolean())" } } },

        "users": {
          "$i": {
            ".validate": "newData.hasChildren(['id'])",
            "$f": { ".validate": "newData.isString() ? newData.val().length <= 500 : (newData.isNumber() || newData.isBoolean())" }
          }
        },
        "gp": {
          "$uid": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" }
        },

