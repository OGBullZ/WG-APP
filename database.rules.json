        "ep":   { "$id": { ".validate": "newData.hasChildren(['id'])", "$f": { ".validate": "newData.isString() ? newData.val().length <= 500 : (newData.isNumber() || newData.isBoolean())" } } },
        "kf":   { "$id": { ".validate": "newData.hasChildren(['id'])", "$f": { ".validate": "newData.isString() ? newData.val().length <= 500 : (newData.isNumber() || newData.isBoolean())" } } },
        "inv":  { "$id": { ".validate": "newData.hasChildren(['id'])", "$f": { ".validate": "newData.isString() ? newData.val().length <= 500 : (newData.isNumber() || newData.isBoolean())" } } },
        "rg":   { "$id": { ".validate": "newData.hasChildren(['id'])", "$f": { ".validate": "newData.isString() ? newData.val().length <= 500 : (newData.isNumber() || newData.isBoolean())" } } },
        "ci":   { "$id": { ".validate": "newData.hasChildren(['id'])", "$f": { ".validate": "newData.isString() ? newData.val().length <= 500 : (newData.isNumber() || newData.isBoolean())" } } },
        "st":   { "$id": { ".validate": "newData.hasChildren(['id'])", "$f": { ".validate": "newData.isString() ? newData.val().length <= 500 : (newData.isNumber() || newData.isBoolean())" } } },
        "vo":   { "$id": { ".validate": "newData.hasChildren(['id'])", "$f": { ".validate": "newData.isString() ? newData.val().length <= 500 : (newData.isNumber() || newData.isBoolean())" } } },
        "lh":   { "$id": { ".validate": "newData.hasChildren(['id'])", "$f": { ".validate": "newData.isString() ? newData.val().length <= 500 : (newData.isNumber() || newData.isBoolean())" } } },
        "wa":   { "$id": { ".validate": "newData.hasChildren(['id'])", "$f": { ".validate": "newData.isString() ? newData.val().length <= 500 : (newData.isNumber() || newData.isBoolean())" } } },
        "kt":   { "$id": { ".validate": "newData.hasChildren(['id'])", "$f": { ".validate": "newData.isString() ? newData.val().length <= 500 : (newData.isNumber() || newData.isBoolean())" } } },
        "wk":   { "$id": { ".validate": "newData.hasChildren(['id'])", "$f": { ".validate": "newData.isString() ? newData.val().length <= 500 : (newData.isNumber() || newData.isBoolean())" } } },
        "ga":   { "$id": { ".validate": "newData.hasChildren(['id'])", "$f": { ".validate": "newData.isString() ? newData.val().length <= 500 : (newData.isNumber() || newData.isBoolean())" } } },
        "zs":  { "$id": { ".validate": "newData.hasChildren(['id'])", "$f": { ".validate": "newData.isString() ? newData.val().length <= 500 : (newData.isNumber() || newData.isBoolean())" } } },
        "budSent": { "$id": { ".validate": "newData.hasChildren(['id'])", "$f": { ".validate": "newData.isString() ? newData.val().length <= 500 : (newData.isNumber() || newData.isBoolean())" } } },

        "push": {
          "$dev": {
            ".validate": "newData.hasChildren(['endpoint'])",
            "endpoint": { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "p256dh":   { ".validate": "newData.isString() && newData.val().length <= 300" },
            "auth":     { ".validate": "newData.isString() && newData.val().length <= 200" },
            "name":     { ".validate": "newData.isString() && newData.val().length <= 100" },
            "t":        { ".validate": "newData.isNumber()" },
            "exp":      { ".validate": "newData.isBoolean()" },
            "shop":     { ".validate": "newData.isBoolean()" },
            "putz":     { ".validate": "newData.isBoolean()" },
            "settle":   { ".validate": "newData.isBoolean()" },
            "remind":   { ".validate": "newData.isBoolean()" },
            "board":    { ".validate": "newData.isBoolean()" },
            "msg":      { ".validate": "newData.isBoolean()" },
            "wash":     { ".validate": "newData.isBoolean()" },
            "away":     { ".validate": "newData.isBoolean()" },
            "repair":   { ".validate": "newData.isBoolean()" },
            "game":     { ".validate": "newData.isBoolean()" },
            "quiet":    { ".validate": "newData.isBoolean()" },
            "qs":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 23" },
            "qe":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 23" },
            "$other":   { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    },

    "sv": {
      "$k": {
        ".read": "$k.length >= 40",
        "cfg": {
          ".write": "$k.length >= 40",
          "code":   { ".validate": "newData.isString() && newData.val().length >= 6 && newData.val().length <= 64" },
          "$other": { ".validate": false }
        },
        "rl": {
          "$id": {
            ".write": "$k.length >= 40",
            ".validate": "newData.hasChildren(['w', 'n']) && newData.child('w').isNumber() && newData.child('n').isNumber()"
          }
        },
        "bk": {
          "$snap": {
            ".write": "$k.length >= 40 && ((!data.exists() && newData.exists()) || (!newData.exists() && data.child('t').val() < now - 1209600000))",
            ".validate": "newData.hasChildren(['t', 'data']) && newData.child('t').isNumber() && newData.child('t').val() <= now + 60000"
          }
        }
      }
    }
  }
}
