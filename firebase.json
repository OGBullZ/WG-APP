{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      "vercel.json",
      "README.md",
      "**/.*",
      "**/node_modules/**",
      "test/**",
      "package.json",
      "package-lock.json"
    ],
    "rewrites": [
      { "source": "/", "destination": "/wgapp.html" }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
      },
      {
        "source": "/wgapp.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
      }
    ]
  }
}
